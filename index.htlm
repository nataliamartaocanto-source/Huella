<!DOCTYPE htlm
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Huella Campus</title>
<style>
body{font-family:Arial,sans-serif;margin:0;background:#eef8ee;color:#1f3b2d}
header{background:#2e7d32;color:white;padding:40px 20px;text-align:center}
main{max-width:900px;margin:auto;padding:20px}
.card{background:white;border-radius:12px;padding:20px;margin:20px 0;box-shadow:0 2px 8px rgba(0,0,0,.1)}
input,select,button{width:100%;padding:12px;margin-top:8px}
button{background:#2e7d32;color:white;border:none;border-radius:8px;cursor:pointer}
.result{margin-top:15px;padding:15px;background:#f1fff1;border-radius:8px}
footer{text-align:center;padding:20px}
</style>
</head>
<body>
<header>
<h1>🌱 Huella Campus</h1>
<p>Conocé tu impacto. Sembrá el cambio.</p>
</header>

<main>
<div class="card">
<h2>Calculadora de Huella de Carbono</h2>

<label>Nombre</label>
<input id="nombre" placeholder="Ingresá tu nombre">

<label>Distancia desde tu hogar al campus (km, solo ida)</label>
<input id="distancia" type="number" value="5">

<label>Días de asistencia por semana</label>
<input id="dias" type="number" value="5">

<label>Medio de transporte</label>
<select id="transporte">
<option value="0">Caminata</option>
<option value="0">Bicicleta</option>
<option value="0.08">Colectivo</option>
<option value="0.10">Motocicleta</option>
<option value="0.19">Automóvil</option>
<option value="0.095">Automóvil compartido</option>
</select>

<button onclick="calcular()">Calcular mi huella</button>

<div id="resultado" class="result"></div>
</div>

<div class="card">
<h2>Compensación Ambiental</h2>
<p>Equivalencias educativas utilizadas:</p>
<ul>
<li>1 árbol nativo = 22 kg CO₂e por año</li>
<li>1 semilla nativa = 2 kg CO₂e potencialmente compensados</li>
</ul>
</div>
</main>

<footer>
Proyecto educativo independiente • Huella Campus
</footer>

<script>
function calcular(){
 const nombre=document.getElementById('nombre').value || 'Estudiante';
 const d=Number(document.getElementById('distancia').value)||0;
 const dias=Number(document.getElementById('dias').value)||0;
 const fe=Number(document.getElementById('transporte').value)||0;

 const diaria=d*2*fe;
 const semanal=diaria*dias;
 const anual=semanal*32;

 const arboles=Math.ceil(anual/22);
 const semillas=Math.ceil(anual/2);

 document.getElementById('resultado').innerHTML=`
 <h3>Resultado para ${nombre}</h3>
 <p><b>Huella diaria:</b> ${diaria.toFixed(2)} kg CO₂e</p>
 <p><b>Huella semanal:</b> ${semanal.toFixed(2)} kg CO₂e</p>
 <p><b>Huella anual:</b> ${anual.toFixed(2)} kg CO₂e</p>
 <p><b>Compensación sugerida:</b> ${arboles} árboles nativos o ${semillas} semillas nativas.</p>
 `;
}
</script>
</body>
</html>
